# Redis ACL Users File
# Синтаксис: user <username> <rules...>

# ============================================
# DEFAULT USER (отключен для безопасности)
# ============================================
user default off nopass ~* &* +@all

# ============================================
# ADMIN - полный доступ
# ============================================
user admin on >AdminStrongPass123! ~* &* +@all

# ============================================
# READ ONLY - только чтение
# ============================================
user readonly on >ReadOnlyPass456! ~* &* +@read +@connection -@write -@dangerous

# ============================================
# CACHE WRITER - работа с кешем
# ============================================
# Доступ только к ключам начинающимся с "cache:"
# Разрешенные команды: GET, SET, SETEX, DEL, EXPIRE, TTL
user cache_writer on >CachePass789! ~cache:* &* +get +set +setex +psetex +del +expire +pexpire +ttl +pttl +ping +auth

# ============================================
# APPLICATION USER - для приложения
# ============================================
# Доступ к ключам app:* и session:*
# Все команды кроме административных
user app_user on >AppUserPass999! ~app:* ~session:* ~temp:* &* +@all -@admin -@dangerous -@slow

# ============================================
# MONITORING - для мониторинга
# ============================================
# Только чтение и команды мониторинга
user monitor on >MonitorPass111! ~* &* +@read +@connection +info +ping +client +slowlog +latency +memory +config|get

# ============================================
# PUB/SUB USER - для сообщений
# ============================================
# Только Pub/Sub команды для каналов channel:*
user pubsub_user on >PubSubPass222! &channel:* &events:* +@pubsub +@connection +ping

# ============================================
# QUEUE WORKER - для очередей задач
# ============================================
# Доступ к спискам (lists) для очередей
user queue_worker on >QueuePass333! ~queue:* ~job:* &* +@list +@connection +@read +del +expire

# ============================================
# ANALYTICS - для аналитики
# ============================================
# Работа только с sorted sets и hashes для статистики
user analytics on >AnalyticsPass444! ~stats:* ~metrics:* &* +@sortedset +@hash +@read +@connection

# ============================================
# TEMPORARY USER - с ограниченным временем
# ============================================
# Можно создать временного пользователя и потом удалить
user temp_access on >TempPass555! ~temp:* &* +@all -@admin -@dangerous

# ============================================
# NOTES:
# ============================================
# Флаги:
#   on/off       - включить/отключить пользователя
#   >password    - установить пароль
#   nopass       - без пароля (небезопасно!)
#   ~pattern     - разрешить доступ к ключам по паттерну
#   ~*           - доступ ко всем ключам
#   &pattern     - разрешить Pub/Sub каналы по паттерну
#   &*           - доступ ко всем каналам
#   +@category   - разрешить категорию команд
#   -@category   - запретить категорию команд
#   +command     - разрешить конкретную команду
#   -command     - запретить конкретную команду
#
# Категории команд:
#   @all         - все команды
#   @read        - команды чтения
#   @write       - команды записи
#   @admin       - административные команды
#   @dangerous   - опасные команды (FLUSHDB, FLUSHALL, etc)
#   @connection  - команды подключения (AUTH, PING, etc)
#   @pubsub      - Pub/Sub команды
#   @list        - команды для списков
#   @hash        - команды для хешей
#   @set         - команды для множеств
#   @sortedset   - команды для отсортированных множеств
#   @string      - команды для строк
#   @slow        - медленные команды
